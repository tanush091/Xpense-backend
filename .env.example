# Xpense API — Supabase connection
# Copy this file to backend/.env (it is git-ignored) and fill in your values.
# run-backend.bat loads it and switches Spring Boot to the "postgres" profile.
#
# Where to find these: Supabase dashboard → Project → Connect → "Session pooler".
# Use the SESSION pooler (port 5432). It supports the prepared statements Hibernate uses
# and works on IPv4 networks. Add ?sslmode=require to the URL.

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# Secret used to sign login tokens. Use a long random string (at least 32 characters).
APP_JWT_SECRET=<replace-with-a-long-random-secret>
